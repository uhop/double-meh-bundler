{
  "name": "double-meh-bundler",
  "version": "1.0.0",
  "description": "Server-side bundler for the double-meh bundle protocol: one fetch-handler core, framework adapters as thin subpaths.",
  "homepage": "https://github.com/uhop/double-meh-bundler#readme",
  "bugs": {
    "url": "https://github.com/uhop/double-meh-bundler/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/uhop/double-meh-bundler.git"
  },
  "license": "BSD-3-Clause",
  "author": "Eugene Lazutkin <eugene.lazutkin@gmail.com> (https://www.lazutkin.com/)",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": "./src/index.js",
    "./*": "./src/*"
  },
  "scripts": {
    "test": "tape6 --flags FO",
    "test:bun": "tape6-bun --flags FO",
    "test:deno": "tape6-deno --flags FO",
    "ts-check": "tsc --noEmit",
    "js-check": "tsc --project tsconfig.check.json",
    "lint": "prettier --check .",
    "lint:fix": "prettier --write .",
    "wiki:index": "wiki-search-index --wiki wiki --repo uhop/double-meh-bundler --file README.md"
  },
  "keywords": [
    "http",
    "bundler",
    "batching",
    "double-meh",
    "zero-dependency"
  ],
  "funding": "https://github.com/sponsors/uhop",
  "files": [
    "src",
    "LICENSE",
    "README.md",
    "llms.txt",
    "llms-full.txt"
  ],
  "tape6": {
    "tests": [
      "/tests/test-*.*js"
    ]
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "double-meh": "^1.1.1",
    "koa": "^3.2.1",
    "prettier": "^3.9.6",
    "tape-six": "^1.16.2",
    "typescript": "^7.0.2",
    "wiki-search-index": "^0.2.0"
  }
}
